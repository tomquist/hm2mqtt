{
  "name": "hm2mqtt",
  "version": "1.10.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "vite-node src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest -c jest.e2e.config.cjs",
    "test:addon": "cd ha_addon && ./test_env.sh",
    "e2e:setup": "./test/e2e/setup.sh",
    "baseline:update": "UPDATE_DISCOVERY_BASELINE=1 npm test -- test/discovery/baseline.test.ts",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "bump-version": "vite-node bump-version.ts",
    "release": "./release.sh"
  },
  "dependencies": {
    "aedes": "^1.1.1",
    "dotenv": "^17.4.2",
    "mqtt": "^5.15.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "jest-util": "^30.4.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-node": "^6.0.0"
  }
}
