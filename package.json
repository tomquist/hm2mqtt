{
  "name": "hm2mqtt",
  "version": "1.8.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:addon": "cd ha_addon && ./test_env.sh",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "prettier --check \"src/**/*.ts\"",
    "lint:fix": "prettier --write \"src/**/*.ts\"",
    "bump-version": "ts-node bump-version.ts",
    "release": "./release.sh"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "dotenv": "^17.4.2",
    "mqtt": "^5.15.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "jest-util": "^30.4.1",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3"
  }
}
